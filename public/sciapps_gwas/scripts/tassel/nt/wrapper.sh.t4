#!/bin/bash
set -euo pipefail

INPUT_F=${h}
extension="${INPUT_F##*.}"
if [ "${extension}" == "gz" ]; then gunzip "${INPUT_F}"; INPUT_F="${INPUT_F%.*}"; fi

Transform=${numericalGenoTransform}
OUTPUT=nt1_marker.txt
MINFREQ=${minfreq}
MARKERFORMAT=${markerformat}

INPUT_M=${mapfile:-}
if [ -n "${INPUT_M}" ]; then
        INPUT_MF=$(basename "${INPUT_M}")
fi

case ${MARKERFORMAT} in
        "Hapmap")         F_FLAG="-h";;
        "HDF5")           F_FLAG="-h5";;
        "VCF")            F_FLAG="-vcf";;
        "Plink")          F_FLAG="-plink -map ${INPUT_MF} -ped";;
        "Flapjack")       F_FLAG="-flapjack -map ${INPUT_MF} -geno";;
esac

[ -f ~/.initialize_mamba ] && source ~/.initialize_mamba
micromamba activate sciapps_gwas

if [ -n "${MINFREQ}" ]; then
	/grid/ware/home/luj/micromamba/envs/sciapps_gwas/share/tassel4-standalone/run_pipeline.pl -Xms32g -Xmx128g -fork1 "${F_FLAG}" "${INPUT_F}" -filterAlign -filterAlignMinFreq "${MINFREQ}" -export filters -runfork1
	INPUT_FF="filters.hmp.txt"
else
    INPUT_FF="${INPUT_F}"
fi

/grid/ware/home/luj/micromamba/envs/sciapps_gwas/share/tassel4-standalone/run_pipeline.pl -Xms32g -Xmx128g -fork1 "${F_FLAG}" "${INPUT_FF}" -numericalGenoTransform "${Transform}" -export "${OUTPUT}" -runfork1

# remove first two lines
tail -n+3 "${OUTPUT}" > temp

# prepare marker file for genome selection
#cp temp gs_${OUTPUT}
#sed -i 's/<Trait>/<Numeric>\n<Marker>/g' gs_${OUTPUT}

# replacing
sed -i 's/0\.0/0/g' temp
sed -i 's/1\.0/1/g' temp
sed -i 's/NaN/-9/g' temp
sed -i 's/0\.5/-9/g' temp
sed -i 's/<Trait>//g' temp
mv temp "${OUTPUT}"

# generate tped for emmax
# convert hapmap format to plink format
/grid/ware/home/luj/micromamba/envs/sciapps_gwas/share/tassel4-standalone/run_pipeline.pl -Xms32g -Xmx128g -fork1 -h "${INPUT_FF}" -export "${INPUT_F}" -exportType Plink -runfork1

# transpose
plink --file "${INPUT_F}.plk" --recode12 --output-missing-genotype 0 --transpose --out "${INPUT_F}" --noweb

# prepare marker file for mlmm
cut -d ' ' -f 1,4- "${INPUT_F}.tped" > temp0
awk '{for(i=4;i<=NF;i=i+2)$i=""; print }' temp0 > temp1
head -n 1 "${INPUT_F}" > temp2
cut -d '	' -f3,4,12- temp2 > temp3
sed -i 's/chrom/Chromosome/g' temp3
sed -i 's/pos/Positions/g' temp3
sed -i 's/PI//g' temp3
cat temp3 temp1 > temp4
awk -v OFS="," '$1=$1' temp4 > nt2mlmm.txt
sed -i 's/,1,/,0,/g' nt2mlmm.txt
sed -i 's/,1,/,0,/g' nt2mlmm.txt
sed -i 's/,2,/,1,/g' nt2mlmm.txt
sed -i 's/,2,/,1,/g' nt2mlmm.txt
sed -i 's/,1$/,0/g' nt2mlmm.txt
sed -i 's/,2$/,1/g' nt2mlmm.txt

mv "${INPUT_F}.tped" nt4.tped
mv "${INPUT_F}.tfam" nt3.tfam
mv "${INPUT_F}.log" nt5.log

gzip nt4.tped
gzip "${OUTPUT}"
gzip nt2mlmm.txt

trap "rm -rf *.sh temp* ${INPUT_F} ${INPUT_F}.plk.* ${INPUT_F}.nof ${INPUT_F}.nosex filters.hmp.txt" exit
